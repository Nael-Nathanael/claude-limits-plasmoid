#!/usr/bin/env python3
"""Keep one quota file per account in ~/.cache/claude-limits/ fresh.

Targets: claude-1 (~/.claude), claude-N (~/.claude-profile-N, ccd), codex (~/.codex), agy (keyring).
A file missing or older than 5 minutes is fetched again from the provider; Claude Code's
statusline can write the claude-N files too, which keeps them fresh with no API call.

File shape: {five_hour: {used_percentage, resets_at}, seven_day: {...}, groups?, tier, error,
saved_at, checked_at} with epoch seconds, or {hidden: true} when not logged in.

Usage: claude-limits-update [--force TARGET]
"""
import base64
import glob
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime

CLAUDE_URL = "https://api.anthropic.com/api/oauth/usage"
CODEX_URL = "https://chatgpt.com/backend-api/wham/usage"
AGY_URL = "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary"
GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token"
MAX_AGE = 300
# Logins keep the old tier ids after Anthropic renamed the plans.
RENAMED_TIERS = {"max 20x": "ultra", "max 5x": "max"}

HOME = os.path.expanduser("~")
OUT = f"{os.environ.get('XDG_CACHE_HOME', HOME + '/.cache')}/claude-limits"
# Optional {client_id, client_secret} of Antigravity's OAuth client, to refresh agy's hourly token.
AGY_OAUTH = f"{os.environ.get('XDG_CONFIG_HOME', HOME + '/.config')}/claude-limits/agy-oauth.json"


class Hidden(Exception):
    """Not logged in."""


def epoch(iso):
    return int(datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()) if iso else None


def window(pct, resets_at):
    return {"used_percentage": pct, "resets_at": resets_at}


def get(url, headers, data=None):
    req = urllib.request.Request(url, data=data, headers=headers)
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def claude_creds_path(n):
    return f"{HOME}/.claude/.credentials.json" if n == "1" else f"{HOME}/.claude-profile-{n}/.credentials.json"


def jwt_exp(token):
    payload = token.split(".")[1]
    return json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))["exp"]


# Claude and Codex tokens are refreshed only by their CLI; an idle account keeps its last numbers.
def fetch_claude(n):
    # A ccd API-key profile has no subscription limits, even if an old login is still saved.
    if os.path.exists(os.path.join(os.path.dirname(claude_creds_path(n)), "ccd.key")):
        raise Hidden
    try:
        with open(claude_creds_path(n)) as f:
            creds = json.load(f)["claudeAiOauth"]
    except (OSError, ValueError, KeyError):
        raise Hidden
    tier = (creds.get("rateLimitTier") or "").replace("default_claude_", "", 1).replace("_", " ")
    tier = RENAMED_TIERS.get(tier, tier)
    if not creds.get("accessToken") or creds.get("expiresAt", 0) < time.time() * 1000:
        return {"tier": tier, "error": f"token expired — run ccd {n} to refresh"}
    usage = get(CLAUDE_URL, {"Authorization": f"Bearer {creds['accessToken']}", "anthropic-beta": "oauth-2025-04-20"})
    win = lambda w: window(w["utilization"], epoch(w.get("resets_at"))) if w else None
    return {"tier": tier, "five_hour": win(usage.get("five_hour")), "seven_day": win(usage.get("seven_day"))}


def fetch_codex():
    try:
        with open(f"{HOME}/.codex/auth.json") as f:
            creds = json.load(f)["tokens"]
    except (OSError, ValueError, KeyError):
        raise Hidden
    token = creds.get("access_token")
    try:
        expired = not token or jwt_exp(token) < time.time()
    except (IndexError, ValueError, KeyError):
        expired = True
    if expired:
        return {"error": "token expired — run codex to refresh"}
    usage = get(CODEX_URL, {
        "Authorization": f"Bearer {token}",
        "ChatGPT-Account-Id": creds.get("account_id", ""),
        "User-Agent": "codex-cli",
    })
    limits = usage.get("rate_limit") or {}
    win = lambda w: window(w["used_percent"], w["reset_at"]) if w else None
    return {
        "tier": usage.get("plan_type") or "",
        "five_hour": win(limits.get("primary_window")),
        "seven_day": win(limits.get("secondary_window")),
    }


# agy keeps its login in the Secret Service keyring.
def agy_creds():
    try:
        import gi
        gi.require_version("Secret", "1")
        from gi.repository import Secret
        return json.loads(Secret.password_lookup_sync(None, {"service": "gemini", "username": "antigravity"}, None))["token"]
    except (ImportError, ValueError, TypeError, KeyError):
        raise Hidden


# The access token lives an hour; refresh our own copy and never write it back, so agy's login is untouched.
def agy_token(creds):
    if datetime.fromisoformat(creds["expiry"]).timestamp() > time.time() + 60:
        return creds["access_token"]
    try:
        with open(AGY_OAUTH) as f:
            client = json.load(f)
    except OSError:
        return None
    body = urllib.parse.urlencode({
        "grant_type": "refresh_token",
        "refresh_token": creds["refresh_token"],
        "client_id": client["client_id"],
        "client_secret": client["client_secret"],
    }).encode()
    return get(GOOGLE_TOKEN_URL, {}, body)["access_token"]


def fetch_agy():
    try:
        token = agy_token(agy_creds())
    except (OSError, ValueError, KeyError) as e:
        return {"error": f"token refresh failed — run agy ({e})"}
    if not token:
        return {"error": "token expired — run agy to refresh"}
    try:
        with open(f"{HOME}/.gemini/antigravity-cli/cache/default_project_id.txt") as f:
            payload = {"project": f.read().strip()}
    except OSError:
        payload = {}
    usage = get(AGY_URL, {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "User-Agent": "antigravity/cli",
    }, json.dumps(payload).encode())
    win = lambda b: window(round((1 - b.get("remainingFraction", 1)) * 100, 1), epoch(b.get("resetTime")))
    groups = [
        {"name": g.get("displayName", "?"), **{b.get("window"): win(b) for b in g.get("buckets", [])}}
        for g in usage.get("groups", [])
    ]
    # Each model group has its own 5h and weekly limit; the pill shows the most used of each.
    most_used = lambda w: max((g[w] for g in groups if w in g), key=lambda x: x["used_percentage"], default=None)
    return {"five_hour": most_used("5h"), "seven_day": most_used("weekly"), "groups": groups}


# name -> (fetch, credentials file whose change means a new login)
def targets():
    found = {
        "claude-1": (lambda: fetch_claude("1"), claude_creds_path("1")),
        "codex": (fetch_codex, f"{HOME}/.codex/auth.json"),
        "agy": (fetch_agy, None),
    }
    # Old files count too: a deleted profile has no login, so its file turns hidden instead of going stale.
    for p in glob.glob(f"{HOME}/.claude-profile-*") + glob.glob(f"{OUT}/claude-*.json"):
        n = p.removesuffix(".json").rsplit("-", 1)[1]
        if re.fullmatch(r"\d+", n) and n != "1":
            found[f"claude-{n}"] = (lambda n=n: fetch_claude(n), claude_creds_path(n))
    return found


def write(path, state):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, path)


def update(name, fetch, creds_path, force):
    path = f"{OUT}/{name}.json"
    try:
        with open(path) as f:
            prev = json.load(f)
    except (OSError, ValueError):
        prev = {}
    now = int(time.time())
    try:
        relogin = os.path.getmtime(creds_path) > prev.get("checked_at", 0)
    except (OSError, TypeError):
        relogin = False
    # A deleted profile folder hides its pill on the next run, not after MAX_AGE.
    gone = creds_path and not os.path.isdir(os.path.dirname(creds_path)) and not prev.get("hidden")
    if not force and not relogin and not gone and now - max(prev.get("saved_at", 0), prev.get("checked_at", 0)) < MAX_AGE:
        return
    # On failure the last numbers stay, with the error beside them.
    prev = {} if prev.get("hidden") else prev
    try:
        state = {**prev, "error": None, **fetch(), "checked_at": now}
        if not state["error"]:
            state["saved_at"] = now
    except Hidden:
        state = {"hidden": True, "checked_at": now}
    except urllib.error.HTTPError as e:
        state = {**prev, "error": f"HTTP {e.code}", "checked_at": now}
    except (OSError, ValueError, KeyError, TypeError) as e:
        state = {**prev, "error": str(e) or type(e).__name__, "checked_at": now}
    write(path, state)


def main():
    force = sys.argv[2] if len(sys.argv) == 3 and sys.argv[1] == "--force" else None
    os.makedirs(OUT, exist_ok=True)
    found = targets()
    if force and force not in found:
        sys.exit(f"unknown target {force}; known: {' '.join(sorted(found))}")
    for name, (fetch, creds_path) in found.items():
        if force in (None, name):
            update(name, fetch, creds_path, force == name)


main()
